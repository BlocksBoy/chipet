# Chipet AI API（OpenAI 兼容，如 DeepSeek）。在仓库根目录构建：
#   docker build -f deploy/Dockerfile.api -t chipet-api:latest .
FROM node:22-bookworm-slim
WORKDIR /app

COPY package.json package-lock.json ./
COPY packages ./packages
COPY server/package.json ./server/

RUN npm ci --workspace=@tapearena/server --include-workspace-root --no-audit --no-fund

COPY server ./server

ENV PORT=8787
ENV NODE_ENV=production
EXPOSE 8787
WORKDIR /app/server
# 密钥由 compose env_file 注入，不打进镜像
CMD ["npx", "tsx", "src/index.ts"]
