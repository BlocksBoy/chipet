# 复制为 contracts/.env 后填写（已 gitignore，勿提交）
# 部署用私钥（EVM 通用；X Layer / BSC 可共用同一把）
X_LAYER_PRIVATE_KEY=0x你的私钥
# 可选：BSC 单独一把时覆盖
# BSC_PRIVATE_KEY=0x你的私钥

# 可选
# TREASURY=0x…
# HATCH_PRICE=0
# CHIPET=0x…          # seed 时若已部署可直接填
# TAPEOUT_FACTORY=0x68224F668083c29e9800Be2a646d42d18cedF7e2   # BSC 默认官方工厂
# CPU=0x50A994E71615474b55559fF4F500928fbc339DD9               # BSC Genesis Circuits
