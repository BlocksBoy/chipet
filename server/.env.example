# 复制为 server/.env 后填写（已 gitignore，勿提交）
# DeepSeek 示例：
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
PORT=8787

# 运营后台：≥16 字符随机口令。登录后发 HttpOnly Cookie，勿把口令写进前端。
# openssl rand -hex 24
ADMIN_TOKEN=

# 跨域携带 Cookie 时填写前端 Origin（逗号分隔）；本地 Vite 代理可留空
# CORS_ORIGIN=https://chipet.web3book.io

# Admin 扫链专用 RPC（密钥只放服务端，勿写进 VITE_*）
# X Layer（196）
# RPC_URL_196=https://xlayer-mainnet.g.alchemy.com/v2/YOUR_KEY
# BSC（56）。需在 Alchemy 开通 BNB Smart Chain；未开通前可用公共节点
# RPC_URL_56=https://bnb-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_URL_56=https://bsc-dataseed.bnbchain.org
# 兼容旧名：仅当未设 RPC_URL_196 时，RPC_URL 作为 X Layer 回退
# RPC_URL=
