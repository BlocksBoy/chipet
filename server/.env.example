# 复制为 server/.env 后填写（已 gitignore，勿提交）
# DeepSeek 示例：
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
PORT=8787

# 运营后台：≥16 字符随机口令。登录后发 HttpOnly Cookie，勿把口令写进前端。
# openssl rand -hex 24
ADMIN_TOKEN=

# 跨域携带 Cookie 时填写前端 Origin（逗号分隔）；本地 Vite 代理可留空
# CORS_ORIGIN=https://chipet.web3book.io

# Admin 扫链专用 RPC（密钥只放服务端，勿写进 VITE_*）
# X Layer（196）/ BSC（56）— dRPC 示例：
# RPC_URL_196=https://lb.drpc.live/xlayer/YOUR_KEY
# RPC_URL_56=https://lb.drpc.live/bsc/YOUR_KEY
# 兼容旧名：仅当未设 RPC_URL_196 时，RPC_URL 作为 X Layer 回退
# RPC_URL=

# Admin 扫链快照 SQLite（默认 ./data/admin.sqlite；Docker 用 /data/admin.sqlite）
# ADMIN_DB_PATH=./data/admin.sqlite

# 运营后台登录会话（Redis）。生产 compose 注入 redis://redis:6379；本地不配则用内存。
# REDIS_URL=redis://127.0.0.1:6379
